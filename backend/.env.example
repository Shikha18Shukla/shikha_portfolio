# Postgres connection string (Render, Railway, Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Port the API listens on
PORT=4000

# Frontend origin allowed to call this API (your Vercel/Netlify URL in production)
CORS_ORIGIN=http://localhost:5173

# --- Optional: email notification on new contact message ---
# Leave blank to skip email notifications; messages are still saved to the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=shikhashuklaknice@email.com
